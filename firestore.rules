rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.role == 'marketing'; // Default role
      allow update: if isAdmin() || (
        isOwner(userId) && (
          // Case 1: Editing profile/bank details, but not roles, stats, or wallets
          (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'commission_balance', 'pulsa_balance', 'markup_balance', 'pulsa_bonus_count', 'pulsa_bonus_month', 'last_pulsa_bonus_at', 'marketing_category', 'total_sales_count', 'total_commission_earned', 'total_pulsa_earned']))
          ||
          // Case 2: Deducting wallet balances for claims (withdrawing)
          (
            // Ensure no other admin/stats/role keys are modified
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'pulsa_bonus_count', 'pulsa_bonus_month', 'last_pulsa_bonus_at', 'marketing_category', 'total_sales_count', 'total_commission_earned', 'total_pulsa_earned']) &&
            // Balances can only be decremented (withdrawn), not increased
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commission_balance']) || 
              request.resource.data.commission_balance <= resource.data.get('commission_balance', 0)) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['markup_balance']) || 
              request.resource.data.markup_balance <= resource.data.get('markup_balance', 0)) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pulsa_balance']) || 
              request.resource.data.pulsa_balance <= resource.data.get('pulsa_balance', 0))
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Products collection (Catalog)
    match /products/{productId} {
      allow read: if true; // Publicly viewable
      allow write: if isAdmin();
    }

    // Sales collection
    match /sales/{saleId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin() || (
        request.auth != null && 
        resource.data.user_id == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shipping_status', 'history']) &&
        request.resource.data.shipping_status == 'SAMPAI'
      );
      allow delete: if isAdmin();
    }

    // Link Bio collection
    match /links/{linkId} {
      allow read: if true; // Public for bio pages
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Global Settings
    match /global_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (request.auth != null && (
        resource.data.recipientId == request.auth.uid || 
        (resource.data.recipientId == 'role:admin' && isAdmin())
      ));
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.recipientId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Wallet & Claims
    match /wallet_history/{historyId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.user_id == request.auth.uid);
    }
    
    // Explicitly deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

